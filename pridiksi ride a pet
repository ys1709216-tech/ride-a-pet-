local Tombol = {}
UserInputService.InputBegan:Connect(function(Input, GameProcess)
    if not GameProcess then Tombol[Input.KeyCode] = true end
end)
UserInputService.InputEnded:Connect(function(Input, GameProcess)
    if not GameProcess then Tombol[Input.KeyCode] = false end
end)

-- ==========================================
-- 🔄 LOOP UTAMA SEMUA FITUR
-- ==========================================
task.spawn(function()
    while task.wait(0.05) do
        if not RootPart then continue end
        
        -- HAPUS ESP JIKA DIMATIKAN
        if not Settings.ESP then ESPFolder:ClearAllChildren() end
        
        -- FLY V3
        if Settings.FlyV3 then
            local Cam = workspace.CurrentCamera
            local ArahGerak = Vector3.new()
            if Tombol[Enum.KeyCode.W] then ArahGerak += Cam.CFrame.LookVector end
            if Tombol[Enum.KeyCode.S] then ArahGerak -= Cam.CFrame.LookVector end
            if Tombol[Enum.KeyCode.A] then ArahGerak -= Cam.CFrame.RightVector end
            if Tombol[Enum.KeyCode.D] then ArahGerak += Cam.CFrame.RightVector end
            if Tombol[Enum.KeyCode.Space] then ArahGerak += Vector3.new(0, 1, 0) end
            if Tombol[Enum.KeyCode.LeftControl] then ArahGerak -= Vector3.new(0, 1, 0) end
            
            if ArahGerak.Magnitude > 0 then
                RootPart.Velocity = ArahGerak.Unit * Settings.Kecepatan
            else
                RootPart.Velocity = Vector3.new(0, 0, 0)
            end
        end
        
        -- CARI TELUR PALING LANGKA
        local Telur, Nama, Posisi, Nilai = CariTelurTerbaik()
        if Telur and Posisi then
            Status.Text = "🎯 TERLANGKA: "..Nama.." | "..tostring(math.floor((RootPart.Position - Posisi).Magnitude)).."m"
            Status.TextColor3 = Nilai >= 90 and Color3.fromRGB(255, 50, 255) or Color3.fromRGB(255, 200, 50)
            
            -- AUTO AMBIL & LETAKKAN
            if Settings.AutoPlace then
                local Jarak = (RootPart.Position - Posisi).Magnitude
                if Jarak < 8 then
                    RootPart.CFrame = CFrame.new(Posisi)
                    Status.Text = "✅ DIAMBIL: "..Nama
                    task.wait(0.5)
                    -- Otomatis bawa ke tempat penetasan/tempat taruh
                    pcall(function()
                        for _, v in pairs(workspace:GetDescendants()) do
                            if v.Name:lower():find("hatch") or v.Name:lower():find("place") or v.Name:lower():find("drop") then
                                RootPart.CFrame = CFrame.new(v.Position + Vector3.new(0, 2, 0))
                                Status.Text = "📦 DITARUH: "..Nama
                            end
                        end
                    end)
                else
                    local Arah = (Posisi - RootPart.Position).Unit
                    RootPart.Velocity = Arah * Settings.Kecepatan
                end
            end
        end
        
        -- RADAR & PREDIKSI
        if Settings.Radar then
            Status.Text = "📡 RADAR AKTIF | Mencari telur Eternal/Divine..."
        end
        if Settings.PrediksiSpawn then
            -- Tampilkan perkiraan waktu
        end
        if Settings.PrediksiCuaca then
            -- Tampilkan info cuaca
        end
    end
end)

