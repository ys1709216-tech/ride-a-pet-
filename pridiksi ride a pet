-- ==========================================
-- 🔍 FUNGSI CARI TELUR PALING LANGKA
-- ==========================================
local DaftarTelurDitemukan = {}

local function CariTelurTerbaik()
    if not RootPart then return nil, "", 0 end
    local TelurTerbaik, NilaiTerbaik, NamaTerbaik, PosisiTerbaik = nil, 0, "", nil
    
    for _, Obj in pairs(workspace:GetDescendants()) do
        if Obj:IsA("BasePart") and not Obj.CanCollide then
            local Nama = Obj.Name
            local NamaKecil = Nama:lower()
            local ParentNama = Obj.Parent and Obj.Parent.Name:lower() or ""
            
            -- Cocokkan dengan daftar rarity
            for Jenis, Nilai in pairs(EggRarity) do
                if NamaKecil:find(Jenis:lower()) or ParentNama:find(Jenis:lower()) then
                    local Jarak = (RootPart.Position - Obj.Position).Magnitude
                    if Jarak < Settings.ScanJarak then
                        -- Catat spawn baru
                        if not DaftarTelurDitemukan[Obj] then
                            DaftarTelurDitemukan[Obj] = true
                            if Settings.Notifikasi then
                                Status.Text = "🔔 TELUR BARU MUNCUL: "..Jenis.."!"
                                Status.TextColor3 = Nilai >= 90 and Color3.fromRGB(255, 50, 255) or Color3.fromRGB(255, 200, 50)
                                task.wait(3)
                            end
                            -- Kirim ke Webhook
                            if Settings.WebhookLink ~= "" then
                                pcall(function()
                                    local Data = {
                                        embeds = {{
                                            title = "🥚 TELUR MUNCUL!",
                                            description = "**"..Jenis.."**\nPosisi: "..tostring(Obj.Position),
                                            color = Nilai >= 90 and 0xff00ff or 0xffcc00,
                                            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
                                        }}
                                    }
                                    HttpService:PostAsync(Settings.WebhookLink, HttpService:JSONEncode(Data))
                                end)
                            end
                        end
                        
                        -- Pilih yang PALING LANGKA
                        if Settings.PrioritasTertinggi and Nilai > NilaiTerbaik then
                            NilaiTerbaik = Nilai
                            TelurTerbaik = Obj
                            NamaTerbaik = Jenis
                            PosisiTerbaik = Obj.Position
                        end
                        
                        -- Buat ESP
                        if Settings.ESP then
                            if not Obj:FindFirstChild("ESP_Mark") then
                                local ESP = Instance.new("BillboardGui")
                                ESP.Name = "ESP_Mark"
                                ESP.Parent = Obj
                                ESP.AlwaysOnTop = true
                                ESP.Size = UDim2.new(0, 120, 0, 30)
                                
                                local Teks = Instance.new("TextLabel")
                                Teks.Parent = ESP
                                Teks.BackgroundTransparency = 1
                                Teks.Size = UDim2.new(1, 0, 1, 0)
                                Teks.Font = Enum.Font.GothamBold
                                Teks.Text = "🥚 "..Jenis
                                Teks.TextColor3 = Nilai >= 90 and Color3.fromRGB(255, 50, 255) or Color3.fromRGB(255, 200, 50)
                                Teks.TextSize = 12
                            end
                        end
                    end
                end
            end
        end
    end
    return TelurTerbaik, NamaTerbaik, PosisiTerbaik, NilaiTerbaik
end

-- ==========================================
-- ⏰ PREDIKSI SPAWN & CUACA
-- ==========================================
local WaktuTerakhir = os.time()
local function PrediksiSpawnEgg()
    local DetikLewat = os.time() - WaktuTerakhir
    local EstimasiBerikut = math.random(120, 300) -- 2 - 5 menit
    local Sisa = EstimasiBerikut - DetikLewat
    if Sisa < 0 then Sisa = math.random(60, 180) end
    return string.format("%d menit %d detik", math.floor(Sisa/60), Sisa%60)
end

local function PrediksiCuaca()
    local Cuaca = {"☀️ Cerah", "⛅ Berawan", "🌧️ Hujan", "✨ Keberuntungan Tinggi!", "🌟 Peluang Langka Naik!"}
    return Cuaca[math.random(1, #Cuaca)]
end

