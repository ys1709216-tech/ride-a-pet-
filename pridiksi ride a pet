task.spawn(function()
    while task.wait(3) do
        if not Settings.AutoSell then continue end
        pcall(function()
            for _, v in pairs(workspace:GetDescendants()) do
                local Nama = v.Name:lower()
                if Nama:find("pet") and (Nama:find("common") or Nama:find("uncommon") or Nama:find("rare")) then
                    -- Klik/jual otomatis pet biasa
                    local Pos = v:IsA("BasePart") and v.Position or nil
                    if Pos then
                        Status.Text = "💰 MENJUAL: "..v.Name
                    end
                end
            end
        end)
    end
end)

